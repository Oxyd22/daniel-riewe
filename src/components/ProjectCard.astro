---
interface Props {
  href: string;
  tag: string;
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  pixel?: boolean;
}
const { href, tag, title, summary, image, imageAlt, pixel = false } = Astro.props;
---
<a class="project-card" href={href}>
  <span class="card-shot">
    <img
      class:list={[{ pixel }]}
      src={image}
      alt={imageAlt}
      width="960"
      height="540"
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="card-body">
    <span class="tag">{tag}</span>
    <h3>{title}</h3>
    <p>{summary}</p>
  </span>
</a>
