---
import type { Lang, ProjectSlug } from "../i18n/content";
import { projects, ui, cardMedia, hobby } from "../i18n/content";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  lang: Lang;
  slug: ProjectSlug;
  /** Optional list of related app cards (used on ios-apps hub). */
  related?: {
    href: string;
    tag: string;
    title: string;
    summary: string;
    image: string;
    imageAlt: string;
    pixel?: boolean;
  }[];
}

const { lang, slug, related } = Astro.props;
const p = projects[slug][lang];
const u = ui[lang];
const media = cardMedia[slug];
const showCard = slug !== "mars-patrol" && !p.heroAlt;
const homeHref = lang === "de" ? "/" : "/en/";
const projectsHref = lang === "de" ? "/projekte/" : "/en/projects/";
---
<div class="container">
  <p class="breadcrumb">
    <a href={homeHref}>{u.homeLabel}</a> /
    <a href={projectsHref}>{u.projectsLabel}</a> /
    {p.title}
  </p>
  <article class="prose">
    <p class="eyebrow">{p.tag}</p>
    <h1>{p.title}</h1>
    {
      showCard && (
        <figure class="project-card-figure">
          <img
            src={media.src}
            alt={media.alt[lang]}
            width="1200"
            height="800"
            loading="eager"
            decoding="async"
          />
          {media.kind === "illustration" && <figcaption>{hobby[lang].illustrationNote}</figcaption>}
        </figure>
      )
    }
    {
      p.heroAlt && (
        <figure class="project-hero">
          <img
            src={`/images/${slug}-hero.webp`}
            alt={p.heroAlt}
            width="1920"
            height="1056"
            loading="eager"
            decoding="async"
          />
          {p.heroCaption && (
            <figcaption>
              {p.heroCaption}{" "}
              {slug === "tschechen-jahn" && (
                <a
                  href="https://www.pexels.com/photo/neon-city-14388641/"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {lang === "de" ? "Quelle" : "Source"}
                </a>
              )}
            </figcaption>
          )}
        </figure>
      )
    }
    {p.body.map((para) => <p>{para}</p>)}
    {p.note && <p class="note">{p.note}</p>}
    {
      p.sections && p.sections.length > 0 && (
        <div class="project-sections">
          {p.sections.map((section) => (
            <section class="project-section">
              <h2>{section.heading}</h2>
              {section.body.map((para) => (
                <p>{para}</p>
              ))}
              {section.note && <p class="note">{section.note}</p>}
              {section.links && section.links.length > 0 && (
                <ul class="section-links">
                  {section.links.map((item) => (
                    <li>
                      <a href={item.href} target="_blank" rel="noopener noreferrer">
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>
      )
    }
    {
      p.flow && (
        <section class="shortcut-block">
          <h2>{p.flow.title}</h2>
          <p>{p.flow.lead}</p>
          <div class="shortcut-shots">
            {p.flow.shots.map((shot) => (
              <figure>
                <img src={shot.src} alt={shot.alt} width="720" height="900" loading="lazy" decoding="async" />
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }
    {
      p.inputs && (
        <section class="shortcut-block">
          <h2>{p.inputs.title}</h2>
          <p>{p.inputs.lead}</p>
          <ul class="shortcut-inputs">
            {p.inputs.items.map((item) => (
              <li>
                <div>
                  <strong>{item.title}</strong>
                  <span>{item.text}</span>
                </div>
                <span class="shortcut-tag">{item.tag}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      p.points && (
        <section class="shortcut-block">
          <h2>{p.points.title}</h2>
          <ul class="shortcut-points">
            {p.points.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )
    }
    {
      p.compare && (
        <section class="shortcut-block">
          <h2>{p.compare.title}</h2>
          <p>{p.compare.lead}</p>
          <div class="shortcut-table-wrap">
            <table class="shortcut-compare">
              <thead>
                <tr>
                  <th scope="col"></th>
                  <th scope="col">{p.compare.colProduct}</th>
                  <th scope="col">{p.compare.colOther}</th>
                </tr>
              </thead>
              <tbody>
                {p.compare.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>{row.ours}</td>
                    <td>{row.other}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="shortcut-fine">{p.compare.fine}</p>
        </section>
      )
    }
    {
      p.underHood && (
        <details class="shortcut-hood">
          <summary>{p.underHood.summary}</summary>
          <p>{p.underHood.body}</p>
        </details>
      )
    }
    {
      p.install && (
        <section class="shortcut-block shortcut-install">
          <h2>{p.install.title}</h2>
          <p>{p.install.sub}</p>
          <p class="shortcut-fine">{p.install.fine}</p>
        </section>
      )
    }
    {
      related && related.length > 0 && (
        <section class="app-list" aria-label={lang === "de" ? "Apps" : "Apps"}>
          <h2>{lang === "de" ? "Die Apps" : "The apps"}</h2>
          <div class="project-grid">
            {related.map((item) => (
              <ProjectCard
                href={item.href}
                tag={item.tag}
                title={item.title}
                summary={item.summary}
                image={item.image}
                imageAlt={item.imageAlt}
                pixel={item.pixel}
              />
            ))}
          </div>
        </section>
      )
    }
    {
      p.links && p.links.length > 0 && (
        <section class="demo-links" aria-label={p.linksHeading ?? "Links"}>
          {p.linksHeading && <h2>{p.linksHeading}</h2>}
          <ul>
            {p.links.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <div class="page-actions">
      {
        p.cta && (
          <a
            class="btn btn-primary"
            href={p.cta.href}
            rel={p.cta.external ? "noopener noreferrer" : undefined}
            target={p.cta.external ? "_blank" : undefined}
          >
            {p.cta.label}
          </a>
        )
      }
      <a class="btn btn-ghost" href={projectsHref}>← {u.backProjects}</a>
    </div>
  </article>
</div>
