---
import { ui, site, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---
<footer class="site-footer">
  <div class="footer-inner">
    <p>© {new Date().getFullYear()} {site.name} · {t.footerNote}</p>
    <p>
      <a href={site.xUrl} rel="noopener noreferrer" target="_blank">{site.xHandle}</a>
      <span aria-hidden="true"> · </span>
      <span>{t.contactFollows}</span>
    </p>
  </div>
</footer>
