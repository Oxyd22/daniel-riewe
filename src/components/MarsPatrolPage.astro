---
import type { Lang } from "../i18n/content";
import { projects, ui } from "../i18n/content";
import { marsPatrol } from "../i18n/marsPatrol";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = projects["mars-patrol"][lang];
const m = marsPatrol[lang];
const u = ui[lang];
const homeHref = lang === "de" ? "/" : "/en/";
const projectsHref = lang === "de" ? "/projekte/" : "/en/projects/";
---

<div class="mp">
  <div class="mp-stars" aria-hidden="true"></div>
  <div class="mp-inner">
    <p class="mp-breadcrumb">
      <a href={homeHref}>{u.homeLabel}</a>
      <span aria-hidden="true"> / </span>
      <a href={projectsHref}>{u.projectsLabel}</a>
      <span aria-hidden="true"> / </span>
      <span>{p.title}</span>
    </p>

    <header class="mp-hero">
      <p class="mp-eyebrow">{m.eyebrow}</p>
      <h1 class="mp-sr-only">{p.title}</h1>
      <img
        class="mp-title-art"
        src="/images/menu_mars_title.webp"
        alt={m.titleAlt}
        width="640"
        height="360"
        loading="eager"
        decoding="async"
      />
      <div class="mp-kitt" aria-hidden="true">
        <span class="mp-kitt-bar"></span>
      </div>
      <p class="mp-insert">{m.insertCoin}</p>
    </header>

    <div class="mp-lede">
      {m.lede.map((para) => <p>{para}</p>)}
    </div>

    <div class="mp-gallery">
      <figure class="mp-frame mp-frame--glow">
        <img
          src="/images/game_credits.webp"
          alt={m.creditsAlt}
          width="640"
          height="360"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{m.creditsCaption}</figcaption>
      </figure>
      <figure class="mp-frame">
        <img
          src="/images/screenshot-macos.webp"
          alt={m.shotAlt}
          width="1280"
          height="800"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{m.shotCaption}</figcaption>
      </figure>
    </div>

    <section class="mp-block">
      <h2>{m.worldHeading}</h2>
      {m.worldBody.map((para) => <p>{para}</p>)}
    </section>

    <section class="mp-block">
      <h2>{m.grokHeading}</h2>
      {m.grokBody.map((para) => <p>{para}</p>)}
    </section>

    <section class="mp-block">
      <h2>{m.howHeading}</h2>
      <ul class="mp-how">
        {
          m.howItems.map((item) => (
            <li>
              <strong>{item.label}</strong>
              <span>{item.text}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mp-block">
      <h2>{m.controlsHeading}</h2>
      <div class="mp-table-wrap">
        <table class="mp-table">
          <thead>
            <tr>
              {m.controlHeaders.map((h) => <th scope="col">{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              m.controls.map((row) => (
                <tr>
                  {row.map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mp-note">{m.controlsNote}</p>
    </section>

    <section class="mp-block">
      <h2>{m.mechanicsHeading}</h2>
      <ul class="mp-how">
        {
          m.mechanicsItems.map((item) => (
            <li>
              <strong>{item.label}</strong>
              <span>{item.text}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mp-block">
      <h2>{m.platformsHeading}</h2>
      <p>{m.platformsBody}</p>
    </section>

    <footer class="mp-legal">
      <p class="mp-fan">{m.fanNotice}</p>
      <p class="mp-mute">{m.trademarks}</p>
      <p class="mp-attr">{m.attribution}</p>
      <p class="mp-mute">{m.licenseLine}</p>
      <p class="mp-mute">{m.privateNote}</p>
    </footer>

    <div class="mp-actions">
      <a class="mp-btn" href={projectsHref}>← {u.backProjects}</a>
    </div>
  </div>
</div>

<style>
  @font-face {
    font-family: "Press Start 2P";
    src: url("/fonts/PressStart2P-Regular.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  .mp {
    --mp-bg: #07060b;
    --mp-night: #120e1a;
    --mp-rust: #7e3018;
    --mp-dust: #c25a24;
    --mp-regolith: #da7a34;
    --mp-kitt: #e82127;
    --mp-cyan: #2fe3f0;
    --mp-amber: #ffc53d;
    --mp-text: #d6dce0;
    --mp-cream: #fff1a8;
    --mp-mute: #8a9099;
    --mp-pixel: "Press Start 2P", "Courier New", Courier, ui-monospace, monospace;

    position: relative;
    isolation: isolate;
    color: var(--mp-text);
    background:
      radial-gradient(ellipse 70% 45% at 50% -5%, rgba(194, 90, 36, 0.18), transparent 55%),
      radial-gradient(ellipse 40% 30% at 90% 20%, rgba(47, 227, 240, 0.07), transparent 50%),
      linear-gradient(180deg, var(--mp-bg) 0%, var(--mp-night) 45%, #0a0810 100%);
    margin: 0;
    padding: 2rem 0 4rem;
    width: 100%;
    min-height: 70vh;
  }

  .mp-stars {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.45;
    background-image:
      radial-gradient(1px 1px at 12% 18%, rgba(214, 220, 224, 0.7), transparent),
      radial-gradient(1px 1px at 28% 42%, rgba(255, 241, 168, 0.5), transparent),
      radial-gradient(1.5px 1.5px at 61% 12%, rgba(47, 227, 240, 0.45), transparent),
      radial-gradient(1px 1px at 78% 33%, rgba(214, 220, 224, 0.55), transparent),
      radial-gradient(1px 1px at 88% 8%, rgba(255, 241, 168, 0.4), transparent),
      radial-gradient(1px 1px at 45% 28%, rgba(214, 220, 224, 0.35), transparent),
      radial-gradient(1px 1px at 6% 55%, rgba(214, 220, 224, 0.4), transparent),
      radial-gradient(1.5px 1.5px at 93% 62%, rgba(232, 33, 39, 0.35), transparent);
  }

  .mp-inner {
    position: relative;
    z-index: 1;
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .mp-breadcrumb {
    font-size: 0.875rem;
    color: var(--mp-mute);
    margin: 0 0 1.5rem;
  }

  .mp-breadcrumb a {
    color: var(--mp-cyan);
    text-decoration: none;
  }

  .mp-breadcrumb a:hover {
    color: var(--mp-cream);
    text-decoration: underline;
  }

  .mp-hero {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .mp-eyebrow {
    font-family: var(--mp-pixel);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    color: var(--mp-amber);
    text-transform: uppercase;
    margin: 0 0 1rem;
    line-height: 1.8;
  }

  .mp-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .mp-title-art {
    display: block;
    width: min(100%, 36rem);
    height: auto;
    margin: 0 auto;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    filter: drop-shadow(0 0 18px rgba(47, 227, 240, 0.25));
  }

  .mp-kitt {
    position: relative;
    height: 4px;
    max-width: 28rem;
    margin: 1.1rem auto 0.85rem;
    background: rgba(232, 33, 39, 0.2);
    border-radius: 2px;
    overflow: hidden;
  }

  .mp-kitt-bar {
    display: block;
    height: 100%;
    width: 28%;
    background: linear-gradient(90deg, transparent, var(--mp-kitt), transparent);
    box-shadow: 0 0 12px var(--mp-kitt);
    animation: mp-sweep 2.2s ease-in-out infinite;
  }

  @keyframes mp-sweep {
    0% {
      transform: translateX(-20%);
    }
    50% {
      transform: translateX(280%);
    }
    100% {
      transform: translateX(-20%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mp-kitt-bar {
      animation: none;
      width: 100%;
      background: var(--mp-kitt);
      opacity: 0.85;
    }
  }

  .mp-insert {
    font-family: var(--mp-pixel);
    font-size: 0.5rem;
    color: var(--mp-kitt);
    letter-spacing: 0.12em;
    margin: 0;
    animation: mp-blink 1.4s step-end infinite;
  }

  @keyframes mp-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mp-insert {
      animation: none;
    }
  }

  .mp-lede {
    margin-bottom: 2rem;
  }

  .mp-lede p {
    margin: 0 0 0.85rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--mp-text);
  }

  .mp-lede p:last-child {
    margin-bottom: 0;
    color: var(--mp-mute);
    font-size: 0.95rem;
  }

  .mp-gallery {
    display: grid;
    gap: 1.25rem;
    margin: 0 0 2.5rem;
  }

  @media (min-width: 720px) {
    .mp-gallery {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }

  .mp-frame {
    margin: 0;
    background: var(--mp-night);
    border: 1px solid rgba(194, 90, 36, 0.35);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .mp-frame--glow {
    border-color: rgba(47, 227, 240, 0.45);
    box-shadow:
      0 0 0 1px rgba(47, 227, 240, 0.12),
      0 0 28px rgba(47, 227, 240, 0.18);
  }

  .mp-frame img {
    width: 100%;
    height: auto;
    display: block;
    background: #000;
  }

  .mp-frame--glow img {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .mp-frame figcaption {
    padding: 0.55rem 0.75rem;
    font-size: 0.8rem;
    color: var(--mp-mute);
    border-top: 1px solid rgba(214, 220, 224, 0.08);
  }

  .mp-block {
    margin-bottom: 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid rgba(126, 48, 24, 0.45);
  }

  .mp-block:last-of-type {
    border-bottom: none;
  }

  .mp-block h2 {
    font-family: var(--mp-pixel);
    font-size: clamp(0.65rem, 2.2vw, 0.8rem);
    line-height: 1.7;
    color: var(--mp-cream);
    margin: 0 0 1rem;
    text-shadow: 0 0 12px rgba(255, 197, 61, 0.25);
  }

  .mp-block p {
    margin: 0 0 0.75rem;
    line-height: 1.6;
  }

  .mp-block p:last-child {
    margin-bottom: 0;
  }

  .mp-how {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .mp-how li {
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem 0.9rem;
    background: rgba(18, 14, 26, 0.65);
    border-left: 3px solid var(--mp-kitt);
    border-radius: 0 6px 6px 0;
  }

  .mp-how strong {
    font-family: var(--mp-pixel);
    font-size: 0.5rem;
    letter-spacing: 0.04em;
    color: var(--mp-cyan);
    line-height: 1.8;
  }

  .mp-how span {
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .mp-table-wrap {
    overflow-x: auto;
    margin-bottom: 0.75rem;
    border: 1px solid rgba(47, 227, 240, 0.2);
    border-radius: 8px;
  }

  .mp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    min-width: 36rem;
  }

  .mp-table th,
  .mp-table td {
    padding: 0.55rem 0.65rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid rgba(214, 220, 224, 0.08);
  }

  .mp-table th {
    font-family: var(--mp-pixel);
    font-size: 0.45rem;
    letter-spacing: 0.04em;
    color: var(--mp-amber);
    background: rgba(7, 6, 11, 0.9);
    white-space: nowrap;
  }

  .mp-table tbody tr:nth-child(even) {
    background: rgba(18, 14, 26, 0.5);
  }

  .mp-table td:first-child {
    color: var(--mp-cream);
    font-weight: 600;
    white-space: nowrap;
  }

  .mp-note {
    font-size: 0.88rem;
    color: var(--mp-mute);
    margin: 0;
  }

  .mp-legal {
    margin: 2.5rem 0 1.5rem;
    padding: 1.1rem 1rem;
    background: rgba(7, 6, 11, 0.75);
    border: 1px solid rgba(126, 48, 24, 0.4);
    border-radius: 8px;
  }

  .mp-fan {
    margin: 0 0 0.65rem;
    font-size: 0.9rem;
    color: var(--mp-cream);
    line-height: 1.5;
  }

  .mp-attr {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--mp-cyan);
  }

  .mp-mute {
    margin: 0 0 0.45rem;
    font-size: 0.78rem;
    color: var(--mp-mute);
    line-height: 1.45;
  }

  .mp-mute:last-child {
    margin-bottom: 0;
  }

  .mp-actions {
    margin-top: 1.5rem;
  }

  .mp-btn {
    display: inline-block;
    font-family: var(--mp-pixel);
    font-size: 0.55rem;
    letter-spacing: 0.04em;
    line-height: 1.8;
    padding: 0.75rem 1.1rem;
    color: var(--mp-bg);
    background: var(--mp-cyan);
    text-decoration: none;
    border-radius: 4px;
    box-shadow: 0 0 16px rgba(47, 227, 240, 0.35);
  }

  .mp-btn:hover {
    color: var(--mp-bg);
    background: var(--mp-cream);
    box-shadow: 0 0 16px rgba(255, 241, 168, 0.35);
  }

  .mp-btn:focus-visible {
    outline: 2px solid var(--mp-amber);
    outline-offset: 3px;
  }
</style>

<style is:global>
  /* Mars page: override site chrome without touching other routes */
  body.theme-mars {
    background: #07060b;
  }

  body.theme-mars .site-header {
    background: rgba(7, 6, 11, 0.92);
    border-bottom-color: rgba(232, 33, 39, 0.35);
  }

  body.theme-mars .brand {
    color: #d6dce0;
  }

  body.theme-mars .brand:hover {
    color: #2fe3f0;
  }

  body.theme-mars .nav a {
    color: #8a9099;
  }

  body.theme-mars .nav a:hover,
  body.theme-mars .nav a[aria-current="page"] {
    color: #fff1a8;
  }

  body.theme-mars .lang-switch a {
    color: #8a9099;
  }

  body.theme-mars .lang-switch a[aria-current="true"] {
    color: #2fe3f0;
  }

  body.theme-mars .site-footer {
    background: #07060b;
    border-top-color: rgba(126, 48, 24, 0.45);
    color: #8a9099;
  }

  body.theme-mars .site-footer a {
    color: #2fe3f0;
  }

  body.theme-mars .site-main {
    padding-bottom: 0;
  }
</style>
