---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectDetail from "../../../components/ProjectDetail.astro";
import { projects, alternatePath } from "../../../i18n/content";

const lang = "de" as const;
const slug = "teslaviewer" as const;
const p = projects[slug][lang];
---
<BaseLayout
  lang={lang}
  title={p.title}
  description={p.description}
  canonicalPath={projects[slug].paths.de}
  alternatePath={alternatePath(lang, slug)}
>
  <ProjectDetail lang={lang} slug={slug} />
</BaseLayout>
