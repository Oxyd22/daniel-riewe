---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ProjectDetail from "../../../../components/ProjectDetail.astro";
import { cardMedia, projects, alternatePath, appSlugs } from "../../../../i18n/content";

const lang = "en" as const;
const slug = "ios-apps" as const;
const p = projects[slug][lang];
const related = appSlugs.map((s) => ({
  href: projects[s].paths.en,
  tag: projects[s][lang].tag,
  title: projects[s][lang].title,
  summary: projects[s][lang].card,
  image: cardMedia[s].src,
  imageAlt: cardMedia[s].alt[lang],
  pixel: cardMedia[s].pixel,
}));
---
<BaseLayout
  lang={lang}
  title={p.title}
  description={p.description}
  canonicalPath={projects[slug].paths.en}
  alternatePath={alternatePath(lang, slug)}
>
  <ProjectDetail lang={lang} slug={slug} related={related} />
</BaseLayout>
