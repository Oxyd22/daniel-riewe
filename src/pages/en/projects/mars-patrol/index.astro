---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import MarsPatrolPage from "../../../../components/MarsPatrolPage.astro";
import { projects, alternatePath } from "../../../../i18n/content";

const lang = "en" as const;
const slug = "mars-patrol" as const;
const p = projects[slug][lang];
---
<BaseLayout
  lang={lang}
  title={p.title}
  description={p.description}
  canonicalPath={projects[slug].paths.en}
  alternatePath={alternatePath(lang, slug)}
  bodyClass="theme-mars"
>
  <MarsPatrolPage lang={lang} />
</BaseLayout>
