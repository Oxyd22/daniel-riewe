---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import { projectsIndex, projects, ui, alternatePath } from "../../../i18n/content";

const lang = "en" as const;
const t = projectsIndex[lang];
const u = ui[lang];
const order = ["ai-kalorien", "tschechen-jahn", "jesaja", "praxis-it", "ios-apps"] as const;
---
<BaseLayout
  lang={lang}
  title={t.title}
  description={t.description}
  canonicalPath="/en/projects/"
  alternatePath={alternatePath(lang, "projects")}
>
  <div class="container">
    <p class="breadcrumb"><a href="/en/">{u.homeLabel}</a> / {t.title}</p>
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.headline}</h1>
    <p class="lede">{t.intro}</p>
    <div class="project-grid" style="margin-top:2rem;">
      {
        order.map((slug) => {
          const p = projects[slug][lang];
          return (
            <ProjectCard
              href={projects[slug].paths.en}
              tag={p.tag}
              title={p.title}
              summary={p.card}
              moreLabel={u.readMore}
            />
          );
        })
      }
    </div>
  </div>
</BaseLayout>
