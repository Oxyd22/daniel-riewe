---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HobbyBlock from "../../../components/HobbyBlock.astro";
import { about, ui, site, alternatePath, illustrations, hobby } from "../../../i18n/content";

const lang = "en" as const;
const t = about[lang];
const u = ui[lang];
const portrait = illustrations.portrait;
---
<BaseLayout
  lang={lang}
  title={t.title}
  description={t.description}
  canonicalPath="/en/about/"
  alternatePath={alternatePath(lang, "about")}
>
  <div class="container">
    <p class="breadcrumb"><a href="/en/">{u.homeLabel}</a> / {t.title}</p>
    <article class="prose">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.headline}</h1>
      <figure class="illus vita-portrait">
        <img src={portrait.src} alt={portrait.alt[lang]} width="848" height="1216" />
        <figcaption>{hobby[lang].illustrationNote}</figcaption>
      </figure>
      <p class="lede">{t.intro}</p>
      <ul class="timeline">
        {
          t.timeline.map((item) => (
            <li>
              <div class="when">{item.when}</div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
      <HobbyBlock lang={lang} />
      <section class="section" aria-labelledby="contact-heading">
        <h2 id="contact-heading">{t.contactTitle}</h2>
        <p>{t.contactBody}</p>
        <div class="page-actions">
          <a class="btn btn-primary" href={site.xUrl} rel="noopener noreferrer" target="_blank">{site.xHandle}</a>
          <a class="btn btn-ghost" href="/en/projects/">{u.projectsLabel}</a>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>
