---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import HobbyBlock from "../components/HobbyBlock.astro";
import { cardMedia, home, projects, alternatePath, homeProjectOrder, illustrations, hobby } from "../i18n/content";

const lang = "de" as const;
const t = home[lang];
const portrait = illustrations.portrait;
const note = hobby[lang].illustrationNote;
---
<BaseLayout
  lang={lang}
  title={t.title}
  description={t.description}
  canonicalPath="/"
  alternatePath={alternatePath(lang, "home")}
>
  <div class="container">
    <section class="hero">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.headline}</h1>
        <p class="lede">{t.lede}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/vita/">{t.ctaVita}</a>
          <a class="btn btn-ghost" href="/projekte/">{t.ctaProjects}</a>
        </div>
      </div>
      <figure class="hero-photo illus">
        <img src={portrait.src} alt={portrait.alt[lang]} width="848" height="1216" />
        <figcaption>{note}</figcaption>
      </figure>
    </section>

    <HobbyBlock lang={lang} />

    <section class="section" aria-labelledby="projects-heading">
      <div class="section-head">
        <div>
          <h2 id="projects-heading">{t.projectsTitle}</h2>
          <p class="lede" style="margin:0;font-size:1.05rem;">{t.projectsIntro}</p>
        </div>
      </div>
      <div class="project-grid">
        {
          homeProjectOrder.map((slug) => {
            const p = projects[slug][lang];
            const media = cardMedia[slug];
            return (
              <ProjectCard
                href={projects[slug].paths.de}
                tag={p.tag}
                title={p.title}
                summary={p.card}
                image={media.src}
                imageAlt={media.alt[lang]}
                pixel={media.pixel}
              />
            );
          })
        }
      </div>
    </section>
  </div>
</BaseLayout>
